#!/bin/sh /etc/rc.common

# netifd 服务管理脚本 ，负责启动/停止/重载 netifd 守护进程

START=20
STOP=90

USE_PROCD=1

# 初始化 switch 硬件 (可被板级脚本 /lib/network 覆盖 setup_switch 定义)
init_switch() {
	setup_switch() { return 0; }

	include /lib/network
	setup_switch
}

# 启动 netifd 守护进程 (procd 管理, respawn 自动重启, watch ubus 事件)
start_service() {
	init_switch

	procd_open_instance
	procd_set_param command /sbin/netifd
	procd_set_param respawn
	procd_set_param watch network.interface
	[ -e /proc/sys/kernel/core_pattern ] && {
		procd_set_param limits core="unlimited"
	}
	procd_close_instance
}

# 重载网络配置: 初始化 switch → ubus call network reload
reload_service() {
	local rv=0

	init_switch
	ubus call network reload || rv=1
	return $rv
}

# 停止网络服务: 关闭 wifi → ifdown 所有接口
stop_service() {
	[ -x /sbin/wifi ] && /sbin/wifi down
	ifdown -a
	sleep 1
}

# ATM桥接网络接口的配置验证
validate_atm_bridge_section()
{
	uci_validate_section network "atm-bridge" "${1}" \
		'unit:uinteger:0' \
		'vci:range(32, 65535):35' \
		'vpi:range(0, 255):8' \
		'atmdev:uinteger:0' \
		'encaps:or("llc", "vc"):llc' \
		'payload:or("bridged", "routed"):bridged'
}

# 验证 OpenWrt IPv4 路由配置
validate_route_section()
{
	uci_validate_section network route "${1}" \
		'interface:string' \
		'target:cidr4' \
		'netmask:netmask4' \
		'gateway:ip4addr' \
		'metric:uinteger' \
		'mtu:uinteger' \
		'table:or(range(0,65535),string)'
}

# 验证 OpenWrt IPv6 路由配置
validate_route6_section()
{
	uci_validate_section network route6 "${1}" \
		'interface:string' \
		'target:cidr6' \
		'gateway:ip6addr' \
		'metric:uinteger' \
		'mtu:uinteger' \
		'table:or(range(0,65535),string)'
}

# 验证 OpenWrt IPv4 路由策略规则
validate_rule_section()
{
	uci_validate_section network rule "${1}" \
		'in:string' \
		'out:string' \
		'src:cidr4' \
		'dest:cidr4' \
		'tos:range(0,31)' \
		'mark:string' \
		'invert:bool' \
		'lookup:or(range(0,65535),string)' \
		'goto:range(0,65535)' \
		'action:or("prohibit", "unreachable", "blackhole", "throw")'
}

# 验证 OpenWrt IPv6 路由策略规则
validate_rule6_section()
{
	uci_validate_section network rule6 "${1}" \
		'in:string' \
		'out:string' \
		'src:cidr6' \
		'dest:cidr6' \
		'tos:range(0,31)' \
		'mark:string' \
		'invert:bool' \
		'lookup:or(range(0,65535),string)' \
		'goto:range(0,65535)' \
		'action:or("prohibit", "unreachable", "blackhole", "throw")'
}

# 验证 switch 设备配置 (platform driver 级别的交换机注册)
validate_switch_section()
{
	uci_validate_section network switch "${1}" \
		'name:string' \
		'enable:bool' \
		'enable_vlan:bool' \
		'reset:bool' \
		'ar8xxx_mib_poll_interval:uinteger' \
		'ar8xxx_mib_type:range(0,1)'
}

# 验证 switch VLAN 配置
validate_switch_vlan()
{
	uci_validate_section network switch_vlan "${1}" \
		'device:string' \
		'vlan:uinteger' \
		'ports:list(ports)'
}

# 注册配置重载触发器和 UCI 校验规则
# network/wireless 配置变更时自动 reload, 且通过 validate 函数做合法性校验
service_triggers()
{
	# /etc/config/network /etc/config/wireless 这两个配置文件发生变化时,自动触发此脚本
	procd_add_reload_trigger network wireless

	procd_open_validate											# 配置文件的合法性校验,打开一个新的验证上下文
	validate_atm_bridge_section									# ATM桥接网络接口的配置验证 
	validate_route_section										# IPv4 静态路由配置
	[ -e /proc/sys/net/ipv6 ] && validate_route6_section		# IPv6 静态路由配置
	validate_rule_section										# IPv4 策略路由配置
	[ -e /proc/sys/net/ipv6 ] && validate_rule6_section			# IPv6 策略路由配置
	validate_switch_section										# switch 配置
	validate_switch_vlan										# vlan 配置
	procd_close_validate										# 配置文件的合法性校验,关闭验证数组
}

# 系统关机: 关闭所有网络接口
shutdown() {
	ifdown -a													# 关闭所有网络接口
	sleep 1
}
