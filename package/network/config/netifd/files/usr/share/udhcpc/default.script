#!/bin/sh

# udhcpc 的内置默认脚本(当 -s 参数未指定时的 fallback)
# 与netifd的dhcp.script不同, 它直接用 ip addr / route 操作而不是通过 ubus/netifd

[ -z "$1" ] && echo "Error: should be run by udhcpc" && exit 1

# 解析 RFC 3442 无类别静态路由, 直接调用 route add
# 参数由 udhcpc 环境变量传入: $1 $2 ... 为 <prefix_len> <dest> <gateway> ...
set_classless_routes() {
	local max=128
	local type
	while [ -n "$1" -a -n "$2" -a $max -gt 0 ]; do
		[ ${1##*/} -eq 32 ] && type=host || type=net
		echo "udhcpc: adding route for $type $1 via $2"
		route add -$type "$1" gw "$2" dev "$interface"
		max=$(($max-1))
		shift 2
	done
}

# DHCP 地址/路由配置 (直接操作 ip addr / route, 不走 netifd)
# 环境变量: $ip $subnet $router $staticroutes $msstaticroutes
setup_interface() {
	echo "udhcpc: ip addr add $ip/${subnet:-255.255.255.0} broadcast ${broadcast:-+} dev $interface"
	ip addr add $ip/${subnet:-255.255.255.0} broadcast ${broadcast:-+} dev $interface

	[ -n "$router" ] && [ "$router" != "0.0.0.0" ] && [ "$router" != "255.255.255.255" ] && {
		echo "udhcpc: setting default routers: $router"

		local valid_gw=""
		for i in $router ; do
			route add default gw $i dev $interface
			valid_gw="${valid_gw:+$valid_gw|}$i"
		done
		
		eval $(route -n | awk '
			/^0.0.0.0\W{9}('$valid_gw')\W/ {next}
			/^0.0.0.0/ {print "route del -net "$1" gw "$2";"}
		')
	}

	# CIDR STATIC ROUTES (rfc3442)
	[ -n "$staticroutes" ] && set_classless_routes $staticroutes
	[ -n "$msstaticroutes" ] && set_classless_routes $msstaticroutes
}


applied=
# udhcpc 动作分派: bound/renew → 配置地址, deconfig → 释放地址
# 最后加载用户钩子 /etc/udhcpc.user
case "$1" in
	deconfig)
		ip -4 addr flush dev "$interface"
	;;
	renew)
		setup_interface update
	;;
	bound)
		setup_interface ifup
	;;
esac

# user rules
[ -f /etc/udhcpc.user ] && . /etc/udhcpc.user

exit 0
