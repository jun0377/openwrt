opengt
 set com 115200n81
 set comecho off
 set senddelay 0.02
 waitquiet 0.2 0.2
 flash 0.1

:start
 send "AT+CGMI^m"
 waitfor 5 "Quectel","OK","ERROR"
 if % = 0 goto quectel
 if % = 1 goto continue
 if % = 2 goto error

:quectel
 print "quectel"
 goto continue

:error
 print "ERROR"
 exit 1

:continue
 exit 0
